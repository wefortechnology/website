# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# Google Analytics 4 Measurement ID (Admin → Data Streams → Web → Measurement ID).
# Looks like G-XXXXXXXXXX. Leave empty to disable analytics (e.g. in local dev).
NEXT_PUBLIC_GA_ID=G-KKVZZQ23CF

# Web3Forms access key — delivers enquiry-form submissions to your inbox.
# Get a free key at https://web3forms.com (enter the email that should receive leads).
# Leave empty and the form will show an error asking visitors to use WhatsApp/phone.
NEXT_PUBLIC_WEB3FORMS_KEY=21ba6874-8773-4d3f-b51d-64159b13ffd1
